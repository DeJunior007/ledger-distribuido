{
  "name": "jungle-wagering",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev:api": "bun src/bootstrap/main-api.ts",
    "dev:consumer": "bun src/bootstrap/main-consumer.ts",
    "dev:outbox": "bun src/bootstrap/main-outbox.ts",
    "dev:scheduler": "bun src/bootstrap/main-scheduler.ts",
    "dev:events-audit": "bun src/bootstrap/main-events-audit.ts",
    "build": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:compliance": "bun scripts/compliance/run-all.ts",
    "test:unit": "bun test --timeout 30000 test/unit",
    "test:integration": "bun test --preload ./test/support/preload.ts --timeout 120000 test/integration",
    "test:concurrency": "bun test --preload ./test/support/preload.ts --timeout 180000 test/concurrency",
    "test:compliance": "bun test --preload ./test/support/preload.ts --timeout 180000 test/compliance",
    "test:e2e": "bun test --preload ./test/support/preload-e2e.ts --timeout 120000 test/e2e",
    "test:load": "bun -e \"console.error('not implemented'); process.exit(1)\"",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency && bun run test:compliance",
    "db:migrate": "bun src/bootstrap/main-migrate.ts",
    "db:migrate:down": "bun src/bootstrap/main-migrate.ts --down",
    "queues:init": "bun scripts/queues-init.ts",
    "dlq:redrive": "bun scripts/dlq-redrive.ts",
    "outbox:requeue": "bun scripts/outbox-requeue.ts",
    "provider:simulate": "bun scripts/provider-simulate.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "@types/express": "5.0.6"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1156.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@smithy/node-http-handler": "4.12.1",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "pg": "8.20.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  }
}
